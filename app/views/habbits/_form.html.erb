<%= form_with(model: habbit) do |form| %>
  <% if habbit.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(habbit.errors.count, "error") %> prohibited this habbit from being saved:</h2>

      <ul>
        <% habbit.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :description, style: "display: block" %>
    <%= form.text_field :description %>
  </div>

  <div>
    <%= form.label :completion_status, style: "display: block" %>
    <%= form.checkbox :completion_status %>
  </div>

  <div>
    <%= form.label :due_date, style: "display: block" %>
    <%= form.date_field :due_date %>
  </div>

  <div>
    <%= form.submit %>
  </div>
<% end %>
