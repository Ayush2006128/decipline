<div id="<%= dom_id habbit %>">
  <div>
    <strong>Description:</strong>
    <%= habbit.description %>
  </div>

  <div>
    <strong>Completion status:</strong>
    <%= habbit.completion_status %>
  </div>

  <div>
    <strong>Due date:</strong>
    <%= habbit.daily_task? ? "Daily task" : habbit.due_date %>
  </div>

</div>
